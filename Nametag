-- Leaderboard TextLabel-ek gyűjteménye (ahol a játékos neve megjelenik)
local leaderboardLabels = {}

-- Összegyűjti az összes olyan TextLabel-t a PlayerGui-ban, ami a játékos nevét tartalmazza
local function collectLeaderboardLabels()
    leaderboardLabels = {}
    local playerName = plr.Name
    
    local function searchForNameLabels(instance)
        if instance:IsA("TextLabel") or instance:IsA("TextButton") then
            local text = instance.Text or ""
            -- Pontos egyezés a játékos nevére
            if text == playerName or text == originalDisplayText then
                table.insert(leaderboardLabels, instance)
            end
        end
        for _, child in ipairs(instance:GetChildren()) do
            searchForNameLabels(child)
        end
    end
    
    searchForNameLabels(plr:WaitForChild("PlayerGui"))
end

-- Display + Leaderboard frissítése
local function updateDisplayAndLeaderboard(enabled)
    local badgeChar = "" -- Verified badge
    
    -- Nametag Display frissítése
    if enabled then
        displayText.Text = originalDisplayText .. badgeChar
    else
        displayText.Text = originalDisplayText
    end
    
    -- Leaderboard TextLabel-ek frissítése
    for _, label in ipairs(leaderboardLabels) do
        if enabled then
            label.Text = originalDisplayText .. badgeChar
        else
            label.Text = originalDisplayText
        end
    end
end

-- Figyelő az új leaderboard elemekre (ha dinamikusan jönnek létre)
