-- Helper a forrás Title objektum lekéréséhez
local function getSourceTitle(rank)
    local basePath = plr:WaitForChild("PlayerGui"):WaitForChild("MainUI"):WaitForChild("RightUI"):WaitForChild("Content"):WaitForChild("Menus"):WaitForChild("Lists"):WaitForChild("Nametag"):WaitForChild("Titles")
    
    local rankFolders = {
        ["Tulajdonos"] = "Fondateur",
        ["Developer"] = "Responsable Staff",
        ["Admin"] = "Administrateur",
        ["Moderator"] = "Moderateur",
        ["Content Creator"] = "Content Creator",
        ["VIP"] = "VIP"
    }
    
    local folderName = rankFolders[rank]
    if not folderName then return nil end
    
    local titleFolder = basePath:FindFirstChild(folderName)
    if not titleFolder then return nil end
    
    local theText = titleFolder:FindFirstChild("TheText")
    if not theText then return nil end
    
    return theText
end

local currentRank = nil
local gradConnections = {}

local function clearGradConnections()
    for _, conn in ipairs(gradConnections) do
        conn:Disconnect()
    end
    gradConnections = {}
end

local function syncGradientToSource(sourceGrad, targetGrad)
    targetGrad.Color = sourceGrad.Color
    targetGrad.Rotation = sourceGrad.Rotation
    targetGrad.Offset = sourceGrad.Offset
    targetGrad.Transparency = sourceGrad.Transparency
    targetGrad.Enabled = sourceGrad.Enabled
end

local function syncImageToSource(sourceImage, targetImage)
    targetImage.Image = sourceImage.Image
    targetImage.ImageColor3 = sourceImage.ImageColor3
    targetImage.ImageTransparency = sourceImage.ImageTransparency
    targetImage.ImageRectOffset = sourceImage.ImageRectOffset
    targetImage.ImageRectSize = sourceImage.ImageRectSize
    targetImage.ScaleType = sourceImage.ScaleType
    targetImage.SliceCenter = sourceImage.SliceCenter
    targetImage.SliceScale = sourceImage.SliceScale
    targetImage.TileSize = sourceImage.TileSize
end

local function setupGradientWatcher(sourceGrad, targetGrad)
    local props = {"Color", "Rotation", "Offset", "Transparency", "Enabled"}
    for _, prop in ipairs(props) do
        local conn = sourceGrad:GetPropertyChangedSignal(prop):Connect(function()
            syncGradientToSource(sourceGrad, targetGrad)
        end)
        table.insert(gradConnections, conn)
    end
end

local function setupImageWatcher(sourceImage, targetImage)
    local props = {"Image", "ImageColor3", "ImageTransparency", "ImageRectOffset", "ImageRectSize", "ScaleType", "SliceCenter", "SliceScale", "TileSize"}
    for _, prop in ipairs(props) do
        local conn = sourceImage:GetPropertyChangedSignal(prop):Connect(function()
            syncImageToSource(sourceImage, targetImage)
        end)
        table.insert(gradConnections, conn)
    end
end

local function applyTitle(rank)
    currentRank = rank
    titleText.Text = rank
    
    -- Régi figyelők törlése
    clearGradConnections()
    
    -- Forrás Title mappa lekérése
    local sourceTitle = getSourceTitle(rank)
    if not sourceTitle then return end
    
    -- --- UIGradient ---
    local existingGrad = titleText:FindFirstChild("UIGradient")
    if existingGrad then
        existingGrad:Destroy()
    end
    
    local sourceGrad = sourceTitle:FindFirstChild("TitlesName"):FindFirstChild("UIGradient")
    if sourceGrad then
        local newGrad = sourceGrad:Clone()
        newGrad.Parent = titleText
        syncGradientToSource(sourceGrad, newGrad)
        setupGradientWatcher(sourceGrad, newGrad)
    end
    
    -- --- ImageRight ---
    local sourceImageRight = sourceTitle:FindFirstChild("ImageRight")
    if sourceImageRight then
        syncImageToSource(sourceImageRight, titleImageRight)
        setupImageWatcher(sourceImageRight, titleImageRight)
    end
    
    -- Bezárjuk a menüt
    menuFrame.Visible = false
end

